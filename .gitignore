# dependencies
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# build
.next/
out/
dist/
build/

# runtime data
*.db
# SQLite WAL / 共享内存边车文件：此前 debug_format2.db-shm/.db-wal 就是因为 *.db
# 匹配不到这两个后缀而被误提交进仓库的（二进制、每次运行都变，属于纯噪音）。
*.db-shm
*.db-wal
*.db-journal
*.sqlite3
data/
# 测试隔离产物：conftest 支持 AIEDU_TEST_SUFFIX，为每个测试进程建独立的
# test_aiedu{_SUFFIX}.db / test_materials{_SUFFIX} / test_backups{_SUFFIX} /
# test_model_settings{_SUFFIX}.json（并行跑测试互不争库）。通配覆盖所有后缀变体。
services/api/tests/test_materials*/
services/api/tests/test_backups*/
services/api/tests/test_model_settings*.json
services/api/tests/test_aiedu*.db*
# pip 中断留下的临时目录（pip-build-tracker-* / pip-install-* / pip-ephem-wheel-cache-*）
services/api/pip-*/
# 本地调试用的临时库
services/api/debug_*.db*
logs/
*.log

# env & secrets
.env
.env.*
!.env.example

# editor / os
.DS_Store
Thumbs.db
.vscode/
.idea/
apps/web/.next/
apps/web/tsconfig.tsbuildinfo

# 审计 / 实测用的临时工作区（隔离数据库、浏览器脚本、截图、迁移前备份）
.audit/
