# AI Edu 环境变量示例。
# 复制为 .env 后按需填写；未配置模型时后端运行于演示模式（响应中标记 demo=true）。

# ---- 模型服务（OpenAI 兼容接口）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 请求超时（秒）
LLM_TIMEOUT=120
# 模型并发路数：章节 / 配套文件 / 初始任务共用一个上限，默认 9（deep 挡位 8 节即全并行）。
# 接托管 API 用默认值即可；若换成单卡自建端点（按队列串行处理请求），设为 1 退化串行，
# 否则排队会超过 LLM_TIMEOUT → 重试再排队 → 永远追不上。
AIEDU_LLM_CONCURRENCY=9

# ---- 数据库 ----
# 默认使用仓库内 data/ 目录下的 SQLite
DATABASE_URL=sqlite:///./data/aiedu.db

# ---- 服务 ----
# 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001
# 演示模式：1=未配置模型时启用内置演示生成器；0=未配置模型时返回明确错误
DEMO_MODE=1
