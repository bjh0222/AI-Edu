# AI Edu 环境变量示例。
# 复制为 .env 后按需填写；未配置模型时后端运行于演示模式（响应中标记 demo=true）。

# ---- 模型服务（OpenAI 兼容接口）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 请求超时（秒）
LLM_TIMEOUT=120

# ---- 数据库 ----
# 默认使用仓库内 data/ 目录下的 SQLite
DATABASE_URL=sqlite:///./data/aiedu.db

# ---- 服务 ----
# 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# 演示模式：1=未配置模型时启用内置演示生成器；0=未配置模型时返回明确错误
DEMO_MODE=1
